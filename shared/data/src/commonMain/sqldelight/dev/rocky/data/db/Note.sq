CREATE TABLE note (
    id TEXT NOT NULL PRIMARY KEY,
    text TEXT NOT NULL,
    timestamp TEXT NOT NULL,
    tag TEXT NOT NULL,
    source_message_ids TEXT NOT NULL DEFAULT '[]',
    evidence TEXT NOT NULL DEFAULT '[]',
    created_at INTEGER NOT NULL
);

selectAll:
SELECT id, text, timestamp, tag, source_message_ids, evidence
FROM note
ORDER BY created_at DESC;

insertNote:
INSERT INTO note(id, text, timestamp, tag, source_message_ids, evidence, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateNote:
UPDATE note
SET text = ?, timestamp = ?, tag = ?, source_message_ids = ?, evidence = ?
WHERE id = ?;

deleteNote:
DELETE FROM note
WHERE id = ?;

deleteLegacyDemoNotes:
DELETE FROM note
WHERE text = 'Sete pessoas perguntaram o preço do curso nos últimos dois minutos. Vale responder agora.'
  AND timestamp = 'agora'
  AND tag = 'SUGESTÃO'
  AND source_message_ids = '[]'
  AND evidence = '[]';

deleteAllNotes:
DELETE FROM note;
